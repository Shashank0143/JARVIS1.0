import logging
from fastapi import FastAPI, HTTPException, status
from pydantic import BaseModel
import uvicorn

# Configure logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(name)s - %(levelname)s - %(message)s")
logger = logging.getLogger("JarvisServer")

app = FastAPI(
    title="Jarvis Production Server",
    description="A high-performance asynchronous API server",
    version="1.0.0"
)

class Item(BaseModel):
    name: str
    description: str | None = None
    price: float

@app.get("/health", status_code=status.HTTP_200_OK)
async def health_check():
    """Liveness probe to check server status."""
    logger.info("Health check endpoint pinged.")
    return {"status": "healthy", "service": "jarvis-backend"}

@app.post("/items", status_code=status.HTTP_201_CREATED)
async def create_item(item: Item):
    """Asynchronous endpoint to receive and log JSON payload data."""
    if item.price <= 0:
        logger.error(f"Validation failed: Price must be positive. Got {item.price}")
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Item price must be greater than zero."
        )
    logger.info(f"Item created successfully: {item.name}")
    return {"message": f"Item '{item.name}' saved successfully.", "item": item}

if __name__ == "__main__":
    # Run server locally on port 8000
    uvicorn.run("main:app", host="127.0.0.1", port=8000, reload=True)
